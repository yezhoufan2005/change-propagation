+++ cp-run-T3-r2/shopfront/server/src/utils/time.ts	2026-10-30 11:59:06
@@ -1,4 +1,11 @@
+/** Format as YYYY-MM-DD in the server's local time zone. */
 export function fmtDate(input: Date | string): string {
   const d = typeof input === 'string' ? new Date(input) : input
   return [d.getFullYear(), String(d.getMonth() + 1).padStart(2, '0'), String(d.getDate()).padStart(2, '0')].join('-')
+}
+
+/** Format as YYYY-MM-DD in UTC. */
+export function fmtDateUTC(input: Date | string): string {
+  const d = typeof input === 'string' ? new Date(input) : input
+  return d.toISOString().slice(0, 10)
 }
