diff -ruN fixture/shopfront/server/src/utils/time.ts /tmp/shop-b2pe/shopfront/server/src/utils/time.ts
--- fixture/shopfront/server/src/utils/time.ts	2026-10-30 12:03:55
+++ /tmp/shop-b2pe/shopfront/server/src/utils/time.ts	2026-10-30 12:23:14
@@ -1,4 +1,12 @@
+// YYYY-MM-DD in the server's local time zone.
 export function fmtDate(input: Date | string): string {
   const d = typeof input === 'string' ? new Date(input) : input
   return [d.getFullYear(), String(d.getMonth() + 1).padStart(2, '0'), String(d.getDate()).padStart(2, '0')].join('-')
+}
+
+// YYYY-MM-DD in UTC. Not interchangeable with fmtDate(): the two disagree whenever the
+// local date and the UTC date differ, e.g. 2026-03-02T00:30+08:00 is 2026-03-01 in UTC.
+export function fmtDateUTC(input: Date | string): string {
+  const d = typeof input === 'string' ? new Date(input) : input
+  return d.toISOString().slice(0, 10)
 }
